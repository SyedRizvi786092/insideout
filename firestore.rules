rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() { return request.auth != null; }
    
    function isAdmin() {
      return isAuth() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isScorer(matchId) {
      let matchData = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return isAuth() && (
        request.auth.uid == matchData.scorerId ||
        request.auth.uid == matchData.createdBy
      );
    }

    // Players: public read, any auth user can create (scorer enters new name), admin updates
    match /players/{playerId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAdmin();
    }

    // Users: read own + admin, write own
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuth() && request.auth.uid == userId;
    }

    // Series: public read, auth create, creator update
    match /series/{seriesId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // Matches: public read, auth create (must set self as creator+scorer), scorer-only update
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.scorerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid ||
        (resource.data.scorerId == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy)
      );

      // Innings subcollection
      match /innings/{inningsId} {
        allow read: if true;
        allow write: if isScorer(matchId);
      }

      // Balls subcollection
      match /balls/{ballId} {
        allow read: if true;
        allow write: if isScorer(matchId);
      }

      // Player stats subcollection
      match /playerStats/{playerId} {
        allow read: if true;
        allow write: if isScorer(matchId);
      }
    }
  }
}
